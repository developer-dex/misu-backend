# Copy to .env and fill in. Never commit .env.

# Port the API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/misu_stall

# Browser origins allowed to call the API, comma-separated.
# Not needed when the server serves the built client itself.
CLIENT_ORIGIN=http://localhost:5173

# Passcode asked for on the login screen. Leave empty to turn login off
# (only do that on your own computer).
APP_PASSCODE=

# Long random string used to sign login tokens. Required when APP_PASSCODE is set.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Time zone used when the server has to work out "today" on its own
APP_TIMEZONE=Asia/Kolkata
