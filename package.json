{
  "name": "misu-stall-server",
  "version": "1.0.0",
  "description": "REST API for the MISU tiramisu stall: sales, shifts, purchases and reports.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
