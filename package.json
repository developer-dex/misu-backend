    "helmet": "^8.3.0",
    "mongoose": "^8.24.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
