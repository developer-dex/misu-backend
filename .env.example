# Copy to .env and fill in. Never commit .env.

# Port the API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/misu_stall

# Browser origins allowed to call the API, comma-separated.
# Not needed when the server serves the built client itself.
CLIENT_ORIGIN=http://localhost:5173

# Long random string that signs login tokens (32+ characters). Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Login account created (or given a new password) by `npm run seed`.
# Quote the password if it has special characters.
SEED_USERNAME=
SEED_PASSWORD=

# Time zone used when the server has to work out "today" on its own
APP_TIMEZONE=Asia/Kolkata
